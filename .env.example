# Copy to .env.local and fill in real values. Never commit .env.local.
# These are SERVER-ONLY secrets: never prefix them with NEXT_PUBLIC_.

# Local PostgreSQL (pgAdmin) connection string
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/nozomkb

# Auth.js signing/encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-value

# Needed when running `next start` on your own machine/server (not Vercel).
AUTH_TRUST_HOST=true

# Week 7: Redis for the BullMQ file-processing Queue (server-side only).
# Defaults to redis://127.0.0.1:6379 when not set.
REDIS_URL=redis://127.0.0.1:6379

# Optional: number of Jobs one Worker process runs at the same time (default 2).
# WORKER_CONCURRENCY=2

# Week 8: embeddings for Semantic Search (server-side only, never NEXT_PUBLIC_).
#   local  (default) free local model intfloat/multilingual-e5-small (384 dims),
#          downloaded once (~130 MB) into .models/ (git-ignored); no API key.
#   openai text-embedding-3-small with dimensions=384; needs OPENAI_API_KEY.
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIMENSIONS=384   (must stay 384: the pgvector column is vector(384))
# OPENAI_API_KEY=            (only for EMBEDDING_PROVIDER=openai; keep it secret)
# EMBEDDING_CACHE_DIR=       (optional: where the local model files are stored)
# SEMANTIC_WORKER_CONCURRENCY=1
