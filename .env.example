# Copy to .env.local and fill in real values. Never commit .env.local.
# These are SERVER-ONLY secrets: never prefix them with NEXT_PUBLIC_.

# Local PostgreSQL (pgAdmin) connection string
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/nozomkb

# Auth.js signing/encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-value

# Needed when running `next start` on your own machine/server (not Vercel).
AUTH_TRUST_HOST=true
